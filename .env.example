GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:3000
FORMA_AUTH_REQUIRED=false
FORMA_AUTH_SECRET=
FORMA_TEACHER_USERNAME=
FORMA_TEACHER_PASSWORD=
FORMA_STUDENT_CREDENTIALS_JSON={}
FORMA_STORAGE_BACKEND=local

# In deployment, use a Neon URL with sslmode=require and set the R2 credentials
# in the backend's private environment rather than here.
# FORMA_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Persistent accounts (registration fails closed until TLS SMTP is configured).
FORMA_PUBLIC_REGISTRATION=false
FORMA_LEGACY_LOGIN_ENABLED=true
FORMA_SMTP_HOST=
FORMA_SMTP_PORT=587
FORMA_SMTP_USERNAME=
FORMA_SMTP_PASSWORD=
FORMA_EMAIL_FROM=
# Frontend server only (set on the Cloudflare Worker; never expose secrets here).
# FORMA_BACKEND_URL=https://your-api.onrender.com

# Generate once using cryptography.fernet.Fernet.generate_key(); store privately.
FORMA_EMAIL_TOKEN_KEY=
FORMA_EMAIL_WORKER_ENABLED=true

# Phase 3: durable document interpretation while Render is awake.
FORMA_DOCUMENT_WORKER_ENABLED=true
FORMA_DOCUMENT_CONCURRENCY=1
FORMA_DOCUMENT_JOB_PAGES=50
FORMA_AI_VISUAL_PAGES=8
FORMA_AI_TIMEOUT_SECONDS=60

# Local open-weight document understanding (explicit opt-in; no paid fallback).
# Existing jobs keep their provider snapshot; paid Gemini is paused by the budget policy.
FORMA_AI_PROVIDER=ollama
FORMA_OLLAMA_BASE_URL=http://127.0.0.1:11434
FORMA_OLLAMA_MODEL=qwen3-vl:8b-instruct
FORMA_OLLAMA_MAX_PAGES=3
FORMA_OLLAMA_BATCH_PAGES=1
FORMA_OLLAMA_IMAGE_EDGE=1120
FORMA_OLLAMA_CONTEXT=8192
FORMA_OLLAMA_OUTPUT_TOKENS=2200
FORMA_OLLAMA_TIMEOUT_SECONDS=120
FORMA_OLLAMA_TOTAL_SECONDS=480
# FORMA_STORAGE_DIR=/absolute/path/to/private/local/storage

# Budgeted cloud Qwen: OFF until explicitly approved. Backend secrets only.
FORMA_AI_PAID_ENABLED=false
FORMA_AI_MONTHLY_BUDGET_USD=4.00
FORMA_AI_MAX_JOB_COST_USD=0.02
FORMA_AI_MAX_CONCURRENT_REQUESTS=1
FORMA_AI_PAID_FALLBACK_ENABLED=false
FORMA_OPENROUTER_API_KEY=
FORMA_OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
# Exact endpoint tag AFTER operator privacy review; blank fails closed.
FORMA_OPENROUTER_ENDPOINT=
FORMA_OPENROUTER_PRIVACY_ACKNOWLEDGED=false
FORMA_OPENROUTER_MAX_PAGES=3
FORMA_OPENROUTER_BATCH_PAGES=3
FORMA_OPENROUTER_IMAGE_EDGE=1120
FORMA_OPENROUTER_OUTPUT_TOKENS=2200
FORMA_OPENROUTER_TIMEOUT_SECONDS=60
FORMA_OPENROUTER_MAX_PROMPT_USD_PER_MILLION=0.25
FORMA_OPENROUTER_MAX_COMPLETION_USD_PER_MILLION=0.75

# Rubric assessment is independent of document understanding; defaults to free Ollama.
# Explicitly choose openrouter only after the synthetic cloud pilot is approved.
FORMA_ASSESSMENT_PROVIDER=ollama

# Teen (13–17) registration: enable only after reviewing the real privacy notice,
# legal-representative process and support/withdrawal contact. No default consent.
FORMA_GUARDIAN_REGISTRATION_ENABLED=false
FORMA_GUARDIAN_PRIVACY_NOTICE_URL=
FORMA_GUARDIAN_PRIVACY_CONTACT=

# Optional content profiles and experimental AI style observations.
# Explicit requests only; reuses the SAME $4/month and $0.02/job ledger.
# No external detector subscription or new API key is required.
# FORMA_INTEGRITY_PROVIDER=openrouter
