GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:3000
FORMA_AUTH_REQUIRED=false
FORMA_AUTH_SECRET=
FORMA_TEACHER_USERNAME=
FORMA_TEACHER_PASSWORD=
FORMA_STUDENT_CREDENTIALS_JSON={}
FORMA_STORAGE_BACKEND=local

# In deployment, use a Neon URL with sslmode=require and set the R2 credentials
# in the backend's private environment rather than here.
# FORMA_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
